{
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "forms.generusbig.my.id" }],
      "destination": "/api/forms"
    },
    {
      "source": "/:slug",
      "has": [{ "type": "host", "value": "forms.generusbig.my.id" }],
      "destination": "/api/forms/:slug"
    },
    {
      "source": "/absensi/:slug",
      "destination": "/api/absensi/:slug"
    },
    {
      "source": "/register/:path*",
      "destination": "/api/register/add-participant"
    },
    {
      "source": "/share/dashboard/:token",
      "destination": "/api/share/dashboard/:token"
    },
    {
      "source": "/((?!api/|assets/|images/|favicon.ico|robots.txt|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://obvvznynkrkgxuckgncz.supabase.co>; rel=preconnect; crossorigin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|images/|favicon.ico|robots.txt|manifest.webmanifest).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
